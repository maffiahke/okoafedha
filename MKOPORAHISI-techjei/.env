# Safaricom Daraja API Credentials
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here

# Paybill (CustomerPaybillBusiness - Party B type 2)
DARAJA_SHORTCODE_PAYBILL=your_paybill_shortcode
DARAJA_PASSKEY_PAYBILL=your_paybill_passkey

# Buy Goods (BuyGoodsBusiness - Party B type 6)
DARAJA_SHORTCODE_BUYGOODS=your_till_number
DARAJA_PASSKEY_BUYGOODS=your_buygoods_passkey

# Callback URL for Daraja to POST transaction results
DARAJA_CALLBACK_URL=https://yourdomain.com/api/mpesa-callback

# Environment: "sandbox" or "production"
DARAJA_ENV=sandbox
