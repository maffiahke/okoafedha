# okoafedha — STK Push (Safaricom Daraja) environment template
# Copy to .env for local dev:  cp .env.example .env
# On Vercel: add each key in Dashboard → Project → Settings → Environment Variables.
# Never commit real secrets — .env is git-ignored, only this example is tracked.

# Local preview server port (server.js uses process.env.PORT, defaults to 3000)
PORT=3001

# Daraja environment: "sandbox" for testing, "production" for live M-Pesa
DARAJA_ENV=sandbox

# Daraja app credentials (from https://developer.safaricom.co.ke → Apps)
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Business shortcodes
# PAYBILL  = Head Office shortcode (BusinessShortCode + PartyB for paybill / query password)
DARAJA_SHORTCODE_PAYBILL=174379
# BUYGOODS = Till number where funds land (PartyB for CustomerBuyGoodsOnline)
DARAJA_SHORTCODE_BUYGOODS=3393561

# LNM passkey from Daraja (single passkey — used for both paybill and buygoods;
# STK password = Base64(BusinessShortCode + Passkey + Timestamp YYYYMMDDHHmmss))
DARAJA_PASSKEY=your_lnm_passkey_here

# Public URL Daraja POSTs payment results to (must be https + reachable from Safaricom)
# e.g. https://okoafedha.vercel.app/api/mpesa-callback
DARAJA_CALLBACK_URL=https://your-domain.com/api/mpesa-callback

# Optional: if set, mpesa-callback validates this shared secret on incoming callbacks
DARAJA_CALLBACK_SECRET=
